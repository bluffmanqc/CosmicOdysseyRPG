<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050510">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌌 Carte Galactique"
        android:textColor="#00e5ff"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_margin="8dp" />

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="#0a0a1a" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1a1a2e">

        <Button
            android:id="@+id/travelBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🚀 Voyager"
            android:backgroundTint="#00ff88"
            android:textColor="#0a0a1a"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/scanBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🔍 Scanner"
            android:backgroundTint="#2196f3"
            android:textColor="#ffffff" />
    </LinearLayout>

    <TextView
        android:id="@+id/systemInfo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Sélectionne un système stellaire..."
        android:textColor="#b0b0b0"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="#0d0d1a"
        android:scrollbars="vertical" />
</LinearLayout>
