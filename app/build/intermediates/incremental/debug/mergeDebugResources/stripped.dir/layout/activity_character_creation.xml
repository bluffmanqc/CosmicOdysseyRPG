<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a1a"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Création de Personnage"
            android:textColor="#00ff88"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/avatarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#1a1a2e"
                android:src="@drawable/ic_character_placeholder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_avatar_overlay" />
        </FrameLayout>

        <RadioGroup
            android:id="@+id/avatarTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/radioAI"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IA"
                android:textColor="#ffffff"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioUpload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photo"
                android:textColor="#ffffff"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/generateAvatarBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="🎨 Générer"
                android:backgroundTint="#00ff88"
                android:textColor="#0a0a1a"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/uploadAvatarBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="📁 Upload"
                android:backgroundTint="#2196f3"
                android:textColor="#ffffff"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/takePhotoBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="📷 Photo"
                android:backgroundTint="#9c27b0"
                android:textColor="#ffffff" />
        </LinearLayout>

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Nom du personnage"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="#1a1a2e"
            android:padding="16dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Race"
            android:textColor="#00ff88"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/raceSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1a1a2e"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Classe"
            android:textColor="#00ff88"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/classSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1a1a2e"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Background"
            android:textColor="#00ff88"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/backgroundSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1a1a2e"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caractéristiques"
            android:textColor="#00ff88"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/strengthValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOR: 10"
                android:textColor="#ffffff" />

            <SeekBar
                android:id="@+id/strengthBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/dexterityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEX: 10"
                android:textColor="#ffffff" />

            <SeekBar
                android:id="@+id/dexterityBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/constitutionValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CON: 10"
                android:textColor="#ffffff" />

            <SeekBar
                android:id="@+id/constitutionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/intelligenceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INT: 10"
                android:textColor="#ffffff" />

            <SeekBar
                android:id="@+id/intelligenceBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/wisdomValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAG: 10"
                android:textColor="#ffffff" />

            <SeekBar
                android:id="@+id/wisdomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/charismaValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHA: 10"
                android:textColor="#ffffff" />

            <SeekBar
                android:id="@+id/charismaBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/luckValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUCK: 10"
                android:textColor="#ffffff" />

            <SeekBar
                android:id="@+id/luckBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp" />
        </LinearLayout>

        <Button
            android:id="@+id/createBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✨ CRÉER LE PERSONNAGE"
            android:textSize="18sp"
            android:backgroundTint="#00ff88"
            android:textColor="#0a0a1a" />

    </LinearLayout>
</ScrollView>
