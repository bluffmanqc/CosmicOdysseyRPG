<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paramètres"
            android:textSize="28sp"
            android:textColor="#00FF41"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp" />

        <!-- OPENROUTER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OpenRouter (MJ IA)"
            android:textSize="18sp"
            android:textColor="#00FF41"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/openrouterKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-or-v1-..."
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@drawable/edit_text_bg"
            android:padding="16dp"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/testOpenRouterButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tester"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2196F3"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/openrouterStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Non testé"
                android:textColor="#888888"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <!-- GROQ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Groq (MJ IA rapide)"
            android:textSize="18sp"
            android:textColor="#00FF41"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/groqKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="gsk_..."
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@drawable/edit_text_bg"
            android:padding="16dp"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/testGroqButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tester"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2196F3"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/groqStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Non testé"
                android:textColor="#888888"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <!-- ELEVENLABS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ElevenLabs (Voix)"
            android:textSize="18sp"
            android:textColor="#00FF41"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/elevenlabsKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk_..."
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@drawable/edit_text_bg"
            android:padding="16dp"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/testElevenLabsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tester"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2196F3"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/fetchVoicesButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Charger voix"
                android:textColor="#0D1117"
                android:backgroundTint="#00FF41" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voix ElevenLabs :"
            android:textSize="14sp"
            android:textColor="#00FF41"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/voiceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- TTS ANDROID FALLBACK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TTS Android gratuit (fallback)"
                android:textSize="16sp"
                android:textColor="#FFFFFF" />

            <Switch
                android:id="@+id/ttsFallbackSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Utilise la voix Android si ElevenLabs manque de crédits"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="32dp" />

        <!-- SAUVEGARDER -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sauvegarder"
            android:textColor="#0D1117"
            android:backgroundTint="#00FF41"
            android:padding="16dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/infoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cosmic Odyssey RPG v1.0"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_gravity="center_horizontal" />

    </LinearLayout>
</ScrollView>
