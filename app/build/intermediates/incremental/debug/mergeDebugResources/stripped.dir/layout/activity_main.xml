<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_cosmic" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#cc0a0a1a" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COSMIC ODYSSEY"
            android:textColor="#00ff88"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:shadowColor="#00ff88"
            android:shadowRadius="15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="RPG Intergalactique"
            android:textColor="#b0b0b0"
            android:textSize="16sp"
            android:letterSpacing="0.2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="48dp">

            <Button
                android:id="@+id/btnNewGame"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="🚀 Nouvelle Partie"
                android:textSize="16sp"
                android:backgroundTint="#00ff88"
                android:textColor="#0a0a1a" />

            <Button
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="▶️ Continuer"
                android:textSize="16sp"
                android:backgroundTint="#2196f3"
                android:textColor="#ffffff" />

            <Button
                android:id="@+id/btnJoinParty"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="🌐 Rejoindre Partie"
                android:textSize="16sp"
                android:backgroundTint="#9c27b0"
                android:textColor="#ffffff" />

            <Button
                android:id="@+id/btnCatalog"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="📖 Catalogues"
                android:textSize="16sp"
                android:backgroundTint="#ff9800"
                android:textColor="#ffffff" />

            <Button
                android:id="@+id/btnBlackMarket"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="🏴‍☠️ Marché Noir"
                android:textSize="16sp"
                android:backgroundTint="#ff1744"
                android:textColor="#ffffff" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="⚙️ Paramètres"
                android:textSize="16sp"
                android:backgroundTint="#607d8b"
                android:textColor="#ffffff" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
