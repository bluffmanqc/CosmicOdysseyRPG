<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cosmic">

    <ImageView
        android:id="@+id/sceneImage"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/sceneImage"
        app:layout_constraintBottom_toTopOf="@id/choicesContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messageList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/choicesContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/inputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/bg_input_container"
        app:layout_constraintBottom_toTopOf="@id/actionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/inputText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Entre ton action..."
            android:textColor="@android:color/white"
            android:textColorHint="#888888"
            android:background="@drawable/bg_edit_text"
            android:padding="12dp"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/sendBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/bg_button_circle"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/voiceBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_volume_on"
            android:background="@drawable/bg_button_circle"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/playBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_play_arrow"
            android:background="@drawable/bg_button_circle"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/diceBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_dice"
            android:background="@drawable/bg_button_circle"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/mapBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_map"
            android:background="@drawable/bg_button_circle"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/sheetBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_character"
            android:background="@drawable/bg_button_circle"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/shopBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_shop"
            android:background="@drawable/bg_button_circle" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
